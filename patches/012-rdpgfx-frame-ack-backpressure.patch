+                rdp_client->orig_end_frame = (void*) rdpgfx->EndFrame;
+                rdpgfx->EndFrame = guac_rdp_gfx_end_frame;
+            }
+
             guac_client_log(client, GUAC_LOG_INFO,
                     "H.264 passthrough enabled for RDPGFX channel.");
 
