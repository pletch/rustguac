+/**
+ * Returns the number of H.264 frames queued on the given layer and not yet
+ * flushed to connected clients.
+ *
+ * This is the backlog between the source of the frames and the clients
+ * consuming them, and thus a direct measure of whether the source is
+ * outrunning the clients. It rises when the render thread is waiting out
+ * client processing lag, and falls as frames are flushed.
+ *
+ * A protocol implementation that can slow its source down -- RDP can, by
+ * delaying the acknowledgement of graphics frames -- should consult this
+ * rather than let the queue reach the cap enforced by
+ * guac_display_layer_set_h264(), where the oldest frames are dropped. A drop
+ * breaks the decoder's reference chain, costing every subsequent frame until
+ * the next keyframe, so arriving at the cap is far more expensive than
+ * slowing down before it.
+ *
+ * @param layer
+ *     The layer to query. May be NULL, in which case zero is returned.
+ *
+ * @return
+ *     The number of queued H.264 frames.
+ */
+int guac_display_layer_h264_backlog(guac_display_layer* layer);
