+/**
+ * Sends all queued H.264 frames for all layers of the given display, marking
+ * each layer that had frames sent with h264_active so that the display plan
+ * knows to suppress its image operations.
+ *
+ * The pending frame write lock MUST be held when calling this function, and the
+ * worker threads MUST be idle (this function writes directly to the client
+ * socket).
+ *
+ * @param display
+ *     The display whose layers should be flushed.
+ *
+ * @return
+ *     Non-zero if H.264 frames were sent for at least one layer, zero
+ *     otherwise. A caller must treat a non-zero return as making the frame
+ *     non-empty, so that a frame boundary ("sync") is still sent for frames
+ *     whose only content was H.264.
+ */
+int PFW_guac_display_flush_h264(guac_display* display);
+
