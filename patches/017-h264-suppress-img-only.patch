+        /* Skip only IMG operations overlapping a region sent as H.264 this
+         * frame — for those regions the H.264 stream replaces the JPEG/PNG/
+         * WebP encoding, which is the entire cost this suppression exists to
+         * avoid.
+         *
+         * COPY and RECT operations are never suppressed. They encode nothing,
+         * so suppressing them saves nothing, and they carry real content: a
+         * window drag is expressed as copies, and dropping those leaves stale
+         * rectangles along the path the window travelled.
+         *
+         * Operations elsewhere on the layer carry updates encoded with other
+         * codecs (CAPROGRESSIVE, CLEARCODEC, PLANAR) and must still be sent,
+         * or those regions go stale. */
+        if (op->type == GUAC_DISPLAY_PLAN_OPERATION_IMG
+                && guac_h264_suppress_enabled()
