 }
 
+/**
+ * Returns the deviceScaleFactor to pair with the given desktopScaleFactor.
+ * MS-RDPBCGR 2.2.1.3.2 permits only 100, 140 and 180, and a server presented
+ * with anything else discards the desktop factor along with it.
+ *
+ * @param desktop_scale
+ *     The desired desktopScaleFactor, as a percentage.
+ *
+ * @return
+ *     The deviceScaleFactor to send alongside it.
+ */
+static int guac_rdp_device_scale(int desktop_scale) {
+
+    /* Matched exactly, these are the values FreeRDP's own /scale option sets
+     * for both factors at once. */
+    if (desktop_scale == 140 || desktop_scale == 180)
+        return desktop_scale;
+
+    /* Any other scale is carried by the desktop factor alone, which is what a
+     * client running at 125%, 150% or 200% sends. */
+    return 100;
+
+}
