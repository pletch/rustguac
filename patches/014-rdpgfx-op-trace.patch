+/**
+ * How often the counts of the frequent surface operations are logged, in
+ * milliseconds. Individual lines would be unusable -- a busy desktop performs
+ * hundreds of cache and copy operations a second -- but a fault that shows up
+ * once in a working day has to be caught by whatever logging was already
+ * running when it happened, so the summary must be cheap enough to leave on.
+ */
+#define GUAC_RDP_GFX_OP_SUMMARY_INTERVAL 10000
+
+/**
+ * Individual surface operations logged per summary interval, across all
+ * operation types. A desktop under load performs hundreds a second, so the
+ * detail has to be capped; a burst is nonetheless what a black region looks
+ * like from here, and the summary counts what the cap discarded.
+ */
+#define GUAC_RDP_GFX_OP_LINES_PER_INTERVAL 10
+
+/**
+ * Returns non-zero if another individual operation line may be logged in the
+ * current summary interval, consuming that allowance.
+ *
+ * @param rdp_client
+ *     The client whose allowance should be consumed.
+ *
+ * @return
+ *     Non-zero if the caller should log, zero if the budget is spent.
+ */
+static int guac_rdp_gfx_op_line_budget(guac_rdp_client* rdp_client) {
+
+    if (rdp_client->gfx_op_lines >= GUAC_RDP_GFX_OP_LINES_PER_INTERVAL)
+        return 0;
+
+    rdp_client->gfx_op_lines++;
+    return 1;
+
+}
+
+/**
+ * Logs the counts of the wrapped surface operations, if any have occurred and
+ * the summary interval has elapsed since the last time they were logged.
+ *
+ * The passthrough frame count is included on every line because it is what
+ * makes the rest meaningful: a copy or cache operation is unremarkable in a
+ * session guacd is decoding, and is a potential source of black pixels in one
+ * it is not.
+ *
+ * @param client
+ *     The client whose counts should be logged.
+ *
+ * @param force
+ *     Non-zero to log regardless of how long it has been, as when an operation
+ *     occurs for the first time.
+ */
+static void guac_rdp_gfx_op_summary(guac_client* client, int force) {
+
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+
+    guac_timestamp now = guac_timestamp_current();
+
+    if (!force && rdp_client->gfx_op_summary_time != 0
+            && now - rdp_client->gfx_op_summary_time
+                < GUAC_RDP_GFX_OP_SUMMARY_INTERVAL)
+        return;
+
+    rdp_client->gfx_op_summary_time = now;
+    rdp_client->gfx_op_lines = 0;
+
+    guac_client_log(client, GUAC_LOG_INFO,
+            "RDPGFX surface ops: solidfill=%i surface-to-surface=%i "
+            "surface-to-cache=%i cache-to-surface=%i (H.264 frames passed "
+            "through undecoded: %i)",
+            rdp_client->gfx_solid_fill_count,
+            rdp_client->gfx_surface_to_surface_count,
+            rdp_client->gfx_surface_to_cache_count,
+            rdp_client->gfx_cache_to_surface_count,
+            rdp_client->h264_passthrough_frames);
+
+}
+
+/**
+ * Returns the guac_client associated with the given RDPGFX context.
+ *
+ * @param context
+ *     The RDPGFX context to resolve.
+ *
+ * @return
+ *     The guac_client behind the context.
+ */
+static guac_client* guac_rdp_gfx_client(RdpgfxClientContext* context) {
+    rdpGdi* gdi = (rdpGdi*) context->custom;
+    return ((rdp_freerdp_context*) gdi->context)->client;
+}
+
+/**
+ * Wrapper for the RDPGFX SolidFill callback, which logs the fill and then
+ * defers to FreeRDP's own handler.
+ *
+ * A solid fill writes into the surface guacd encodes from, so it is one of the
+ * ways a region the browser is painting from its own H.264 decoder can be
+ * overwritten by guacd. The colour is logged because a fill with zero
+ * components is indistinguishable, on screen, from a region that was never
+ * painted at all.
+ */
+static UINT guac_rdp_gfx_solid_fill(RdpgfxClientContext* context,
+        const RDPGFX_SOLID_FILL_PDU* pdu) {
+
+    guac_client* client = guac_rdp_gfx_client(context);
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+
+    int first = (rdp_client->gfx_solid_fill_count == 0);
+    rdp_client->gfx_solid_fill_count++;
+
+    if (pdu != NULL && (first || (rdp_client->h264_passthrough_frames > 0
+                    && guac_rdp_gfx_op_line_budget(rdp_client))))
+        guac_client_log(client, GUAC_LOG_INFO,
+                "RDPGFX SolidFill: surface=%u, colour=%02X%02X%02X%02X, "
+                "%u rect(s)%s", pdu->surfaceId,
+                pdu->fillPixel.B, pdu->fillPixel.G, pdu->fillPixel.R,
+                pdu->fillPixel.XA, pdu->fillRectCount,
+                first ? " (first of the session)" : "");
+
+    guac_rdp_gfx_op_summary(client, first);
+
+    pcRdpgfxSolidFill orig = (pcRdpgfxSolidFill) rdp_client->orig_solid_fill;
+    if (orig != NULL)
+        return orig(context, pdu);
+
+    return CHANNEL_RC_OK;
+
+}
+
+/**
+ * Wrapper for the RDPGFX SurfaceToSurface callback, which logs the copy and
+ * then defers to FreeRDP's own handler.
+ *
+ * The copy is performed by FreeRDP between its own surfaces. Under H.264
+ * passthrough the source region may never have been decoded, in which case
+ * what is copied is not the picture the browser is showing but the blank
+ * buffer behind it.
+ */
+static UINT guac_rdp_gfx_surface_to_surface(RdpgfxClientContext* context,
+        const RDPGFX_SURFACE_TO_SURFACE_PDU* pdu) {
+
+    guac_client* client = guac_rdp_gfx_client(context);
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+
+    int first = (rdp_client->gfx_surface_to_surface_count == 0);
+    rdp_client->gfx_surface_to_surface_count++;
+
+    if (pdu != NULL && (first || (rdp_client->h264_passthrough_frames > 0
+                    && guac_rdp_gfx_op_line_budget(rdp_client))))
+        guac_client_log(client, GUAC_LOG_INFO,
+                "RDPGFX SurfaceToSurface: %u -> %u, src %ux%u at %u,%u, "
+                "%u destination(s)%s",
+                pdu->surfaceIdSrc, pdu->surfaceIdDest,
+                pdu->rectSrc.right - pdu->rectSrc.left,
+                pdu->rectSrc.bottom - pdu->rectSrc.top,
+                pdu->rectSrc.left, pdu->rectSrc.top, pdu->destPtsCount,
+                first ? " (first of the session)" : "");
+
+    guac_rdp_gfx_op_summary(client, first);
+
+    pcRdpgfxSurfaceToSurface orig =
+            (pcRdpgfxSurfaceToSurface) rdp_client->orig_surface_to_surface;
+    if (orig != NULL)
+        return orig(context, pdu);
+
+    return CHANNEL_RC_OK;
+
+}
+
+/**
+ * Wrapper for the RDPGFX SurfaceToCache callback, which logs the cache store
+ * and then defers to FreeRDP's own handler.
+ *
+ * What is stored is read out of FreeRDP's surface, so under passthrough a
+ * cache slot filled from an H.264 region holds blank pixels. Nothing is wrong
+ * on screen at this point; the damage appears later, when the slot is restored.
+ */
+static UINT guac_rdp_gfx_surface_to_cache(RdpgfxClientContext* context,
+        const RDPGFX_SURFACE_TO_CACHE_PDU* pdu) {
+
+    guac_client* client = guac_rdp_gfx_client(context);
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+
+    int first = (rdp_client->gfx_surface_to_cache_count == 0);
+    rdp_client->gfx_surface_to_cache_count++;
+
+    if (pdu != NULL && first)
+        guac_client_log(client, GUAC_LOG_INFO,
+                "RDPGFX SurfaceToCache: surface=%u, slot=%u, %ux%u at %u,%u "
+                "(first of the session)", pdu->surfaceId, pdu->cacheSlot,
+                pdu->rectSrc.right - pdu->rectSrc.left,
+                pdu->rectSrc.bottom - pdu->rectSrc.top,
+                pdu->rectSrc.left, pdu->rectSrc.top);
+
+    guac_rdp_gfx_op_summary(client, first);
+
+    pcRdpgfxSurfaceToCache orig =
+            (pcRdpgfxSurfaceToCache) rdp_client->orig_surface_to_cache;
+    if (orig != NULL)
+        return orig(context, pdu);
+
+    return CHANNEL_RC_OK;
+
+}
+
+/**
+ * Wrapper for the RDPGFX CacheToSurface callback, which logs the restore and
+ * then defers to FreeRDP's own handler.
+ *
+ * This is the operation that makes a stale cache slot visible: it writes the
+ * slot's contents into the surface and invalidates the region, so guacd
+ * encodes and sends whatever the slot holds -- over the top of whatever the
+ * browser had drawn there from its own decoder. Destination coordinates are
+ * logged so a black region reported by a user can be matched against them.
+ */
+static UINT guac_rdp_gfx_cache_to_surface(RdpgfxClientContext* context,
+        const RDPGFX_CACHE_TO_SURFACE_PDU* pdu) {
+
+    guac_client* client = guac_rdp_gfx_client(context);
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+
+    int first = (rdp_client->gfx_cache_to_surface_count == 0);
+    rdp_client->gfx_cache_to_surface_count++;
+
+    if (pdu != NULL && (first || (rdp_client->h264_passthrough_frames > 0
+                    && guac_rdp_gfx_op_line_budget(rdp_client)))) {
+
+        /* One line per PDU, naming the first destination only: a PDU may carry
+         * many, and the count is enough to say whether the rest are worth
+         * chasing at trace level. */
+        int x = -1, y = -1;
+        if (pdu->destPtsCount > 0 && pdu->destPts != NULL) {
+            x = pdu->destPts[0].x;
+            y = pdu->destPts[0].y;
+        }
+
+        guac_client_log(client, GUAC_LOG_INFO,
+                "RDPGFX CacheToSurface: slot=%u -> surface=%u, %u "
+                "destination(s), first at %i,%i%s",
+                pdu->cacheSlot, pdu->surfaceId, pdu->destPtsCount, x, y,
+                first ? " (first of the session)" : "");
+
+    }
+
+    guac_rdp_gfx_op_summary(client, first);
+
+    pcRdpgfxCacheToSurface orig =
+            (pcRdpgfxCacheToSurface) rdp_client->orig_cache_to_surface;
+    if (orig != NULL)
+        return orig(context, pdu);
+
+    return CHANNEL_RC_OK;
+
+}
+
+/**
+ * Wrapper for the RDPGFX ResetGraphics callback, which logs the reset and then
+ * defers to FreeRDP's own handler.
+ *
+ * A reset re-establishes the whole graphics pipeline: surfaces are recreated
+ * blank and the desktop may change size. Windows performs one on a desktop
+ * switch -- the lock screen, or a UAC prompt -- which is precisely the sort of
+ * thing that happens to an unattended session. Always logged: it is rare, and
+ * it is the event most likely to precede a screen going black.
+ */
+static UINT guac_rdp_gfx_reset_graphics(RdpgfxClientContext* context,
+        const RDPGFX_RESET_GRAPHICS_PDU* pdu) {
+
+    guac_client* client = guac_rdp_gfx_client(context);
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+
+    if (pdu != NULL)
+        guac_client_log(client, GUAC_LOG_INFO,
+                "RDPGFX ResetGraphics: %ux%u, %u monitor(s) (H.264 frames "
+                "passed through undecoded: %i)", pdu->width, pdu->height,
+                pdu->monitorCount, rdp_client->h264_passthrough_frames);
+
+    guac_rdp_gfx_op_summary(client, 1);
+
+    pcRdpgfxResetGraphics orig =
+            (pcRdpgfxResetGraphics) rdp_client->orig_reset_graphics;
+    if (orig != NULL)
+        return orig(context, pdu);
+
+    return CHANNEL_RC_OK;
+
+}
+
+/**
+ * Wrapper for the RDPGFX CreateSurface callback, which logs the creation and
+ * then defers to FreeRDP's own handler. A new surface is blank until something
+ * paints it, and under passthrough nothing in guacd ever does.
+ */
+static UINT guac_rdp_gfx_create_surface(RdpgfxClientContext* context,
+        const RDPGFX_CREATE_SURFACE_PDU* pdu) {
+
+    guac_client* client = guac_rdp_gfx_client(context);
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+
+    if (pdu != NULL)
+        guac_client_log(client, GUAC_LOG_INFO,
+                "RDPGFX CreateSurface: surface=%u, %ux%u",
+                pdu->surfaceId, pdu->width, pdu->height);
+
+    pcRdpgfxCreateSurface orig =
+            (pcRdpgfxCreateSurface) rdp_client->orig_create_surface;
+    if (orig != NULL)
+        return orig(context, pdu);
+
+    return CHANNEL_RC_OK;
+
+}
+
+/**
+ * Wrapper for the RDPGFX DeleteSurface callback, which logs the deletion and
+ * then defers to FreeRDP's own handler. Paired with the creation log, this says
+ * whether the server tore down and rebuilt its surfaces mid-session.
+ */
+static UINT guac_rdp_gfx_delete_surface(RdpgfxClientContext* context,
+        const RDPGFX_DELETE_SURFACE_PDU* pdu) {
+
+    guac_client* client = guac_rdp_gfx_client(context);
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+
+    if (pdu != NULL)
+        guac_client_log(client, GUAC_LOG_INFO,
+                "RDPGFX DeleteSurface: surface=%u", pdu->surfaceId);
+
+    pcRdpgfxDeleteSurface orig =
+            (pcRdpgfxDeleteSurface) rdp_client->orig_delete_surface;
+    if (orig != NULL)
+        return orig(context, pdu);
+
+    return CHANNEL_RC_OK;
+
+}
