@@ -734,6 +734,32 @@ struct guac_display_layer {
      */
     int h264_rect_count;
 
+    /**
+     * Non-zero if a non-H.264 surface command has been received for this layer
+     * since the last frame flush. Set by
+     * guac_display_layer_mark_mixed_codec() and consumed by
+     * PFW_guac_display_flush_h264(), which transfers it to h264_mixed_frame.
+     */
+    int h264_mixed_pending;
+
+    /**
+     * Non-zero if the frame currently being flushed also carried content
+     * encoded with a codec other than H.264. Suppression of image operations
+     * is disabled for such frames.
+     *
+     * Suppression assumes the H.264 stream is the sole source of truth for the
+     * regions it covers. That holds for a server encoding the whole surface as
+     * H.264, but not for one that paints other content over the same area --
+     * Windows drawing a menu across a video region, for instance. The
+     * overlaying content arrives via CAPROGRESSIVE or CLEARCODEC, lands inside
+     * an H.264 region, and would be suppressed, leaving the region stale.
+     *
+     * The test is per frame rather than per session so that a server which
+     * mixes only occasionally keeps the benefit of suppression on its
+     * H.264-only frames.
+     */
+    int h264_mixed_frame;
+
 };
 
