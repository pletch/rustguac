+void guac_display_layer_mark_mixed_codec(guac_display_layer* layer) {
+
+    /* Deliberately unlocked. This flag only ever transitions 0 -> 1 within a
+     * frame and is reset under the pending frame lock during the flush, so the
+     * worst outcome of a race is that suppression is disabled one frame later
+     * than it might have been. Taking the write lock here instead would mean
+     * doing so for every non-H.264 surface command. */
+    layer->h264_mixed_pending = 1;
+
+}
