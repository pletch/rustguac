diff --git a/src/libguac/display-plan.c b/src/libguac/display-plan.c
index 7eac1710..7e6cc8a7 100644
--- a/src/libguac/display-plan.c
+++ b/src/libguac/display-plan.c
@@ -429,6 +429,54 @@ static void guac_display_plan_send_h264_frame(guac_client* client,
 
 }
 
+/**
+ * Records a region covered by an H.264 frame sent for the given layer during
+ * the current frame, so that guac_display_plan_apply() can suppress image
+ * operations overlapping it. Identical regions are recorded only once --
+ * servers typically send many frames covering the same rect. Once
+ * GUAC_DISPLAY_LAYER_MAX_H264_RECTS distinct regions are held, further regions
+ * are merged into the last slot.
+ */
+static void guac_display_layer_add_h264_rect(guac_display_layer* layer,
+        const guac_rect* rect) {
+
+    /* Ignore duplicates */
+    for (int i = 0; i < layer->h264_rect_count; i++) {
+        guac_rect* existing = &layer->h264_rects[i];
+        if (existing->left == rect->left && existing->top == rect->top
+                && existing->right == rect->right
+                && existing->bottom == rect->bottom)
+            return;
+    }
+
+    if (layer->h264_rect_count < GUAC_DISPLAY_LAYER_MAX_H264_RECTS) {
+        layer->h264_rects[layer->h264_rect_count++] = *rect;
+        return;
+    }
+
+    /* Out of slots: widen the last region to cover this one too. This
+     * over-suppresses rather than losing track of a covered region. */
+    guac_rect_extend(&layer->h264_rects[GUAC_DISPLAY_LAYER_MAX_H264_RECTS - 1],
+            rect);
+
+}
+
+/**
+ * Returns non-zero if the given region intersects any region covered by an
+ * H.264 frame sent for the given layer during the current frame.
+ */
+static int guac_display_layer_h264_covers(guac_display_layer* layer,
+        const guac_rect* rect) {
+
+    for (int i = 0; i < layer->h264_rect_count; i++) {
+        if (guac_rect_intersects(rect, &layer->h264_rects[i]))
+            return 1;
+    }
+
+    return 0;
+
+}
+
 /**
  * Sends all queued H.264 frames from the given layer to connected clients,
  * freeing each frame after sending. Frames are sent in order to preserve
@@ -459,6 +507,11 @@ static int guac_display_plan_flush_h264(guac_client* client,
 
         guac_display_plan_send_h264_frame(client, socket, layer, frame);
 
+        /* Remember the region this frame covers so that image operations
+         * overlapping it can be suppressed, while operations elsewhere on the
+         * layer (other codecs) are still sent */
+        guac_display_layer_add_h264_rect(layer, &frame->rect);
+
         if (frame->is_keyframe)
             layer->h264_keyframe_sent = 1;
 
@@ -500,16 +553,14 @@ int PFW_guac_display_flush_h264(guac_display* display) {
     for (guac_display_layer* layer = display->pending_frame.layers;
             layer != NULL; layer = layer->pending_frame.next) {
 
-        /* Clear the previous frame's state before deciding this frame's */
-        layer->h264_active = 0;
+        /* Clear the previous frame's regions before recording this frame's */
+        layer->h264_rect_count = 0;
 
         if (layer->h264_queue == NULL)
             continue;
 
-        if (guac_display_plan_flush_h264(client, client->socket, layer) > 0) {
-            layer->h264_active = 1;
+        if (guac_display_plan_flush_h264(client, client->socket, layer) > 0)
             sent_any = 1;
-        }
 
     }
 
@@ -535,10 +586,13 @@ void guac_display_plan_apply(guac_display_plan* plan) {
 
         guac_display_layer* display_layer = op->layer;
 
-        /* Skip all operations for layers whose contents were sent as H.264
-         * this frame — the H.264 stream replaces JPEG/PNG/WebP encoding
-         * entirely */
-        if (display_layer->h264_active) {
+        /* Skip only those operations overlapping a region sent as H.264 this
+         * frame — for those regions the H.264 stream replaces JPEG/PNG/WebP
+         * encoding. Operations elsewhere on the layer carry updates encoded
+         * with other codecs (CAPROGRESSIVE, CLEARCODEC, PLANAR) and must still
+         * be sent, or those regions go stale. */
+        if (display_layer->h264_rect_count > 0
+                && guac_display_layer_h264_covers(display_layer, &op->dest)) {
             op++;
             continue;
         }
