+/**
+ * Returns the RDPGFX capability versions to suppress, as a FreeRDP
+ * GfxCapsFilter bitmask, or zero to advertise everything.
+ *
+ * The AVC_THINCLIENT flag that requests AVC420 rather than AVC444 is only
+ * carried by capability sets from version 10.3 onward: FreeRDP appends the
+ * V10, V10.1 and V10.2 sets before adding the flag to its working copy of the
+ * flags. A server free to choose any version may therefore confirm one that
+ * never carried the request, and send AVC444 anyway.
+ *
+ * Setting GUAC_RDP_H264_CAPS_FILTER=1 suppresses V8, V8.1, V10, V10.1 and
+ * V10.2 (bits 0 through 4 of the filter, in the order FreeRDP lists them in
+ * rdpgfx_is_capability_filtered), leaving only 10.3 and later -- every one of
+ * which carries the flag.
+ *
+ * Off by default: it narrows what the session can negotiate, and a server
+ * supporting nothing above 10.2 would end up with no graphics pipeline at all.
+ *
+ * @return
+ *     The GfxCapsFilter bitmask to apply, or zero for no filtering.
+ */
+static UINT32 guac_rdp_h264_caps_filter(void) {
+
+    const char* value = getenv("GUAC_RDP_H264_CAPS_FILTER");
+
+    /* V8 | V8.1 | V10 | V10.1 | V10.2 */
+    if (value != NULL && strcmp(value, "1") == 0)
+        return 0x1F;
+
+    return 0;
+
+}
