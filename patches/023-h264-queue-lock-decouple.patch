@@ -562,7 +562,20 @@ static int guac_display_plan_flush_h264(guac_client* client,
         guac_socket* socket, guac_display_layer* layer) {
 
     int sent = 0;
+
+    /* Detach the whole queue up front rather than walking it in place. The
+     * protocol thread may append to the queue at any time, and sending
+     * involves socket writes -- holding the queue lock across those would
+     * reintroduce exactly the stall this lock exists to avoid. Frames appended
+     * during the send are simply carried by the next flush. */
+    pthread_mutex_lock(&layer->h264_queue_lock);
+
     struct guac_h264_frame* frame = layer->h264_queue;
+    layer->h264_queue = NULL;
+    layer->h264_queue_tail = NULL;
+    layer->h264_queue_length = 0;
+
+    pthread_mutex_unlock(&layer->h264_queue_lock);
 
     while (frame != NULL) {
         struct guac_h264_frame* next = frame->next;
@@ -619,10 +632,6 @@ static int guac_display_plan_flush_h264(guac_client* client,
         sent++;
     }
 
-    layer->h264_queue = NULL;
-    layer->h264_queue_tail = NULL;
-    layer->h264_queue_length = 0;
-
     if (sent > 0)
         guac_client_log(client, GUAC_LOG_DEBUG,
                 "H.264 passthrough: flushed %d frames", sent);
@@ -665,9 +674,9 @@ int PFW_guac_display_flush_h264(guac_display* display) {
 
         pthread_mutex_unlock(&layer->mixed_rect_lock);
 
-        if (layer->h264_queue == NULL)
