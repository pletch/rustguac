+/**
+ * Returns non-zero if AVC444 should be advertised alongside AVC420 for a
+ * session with the given per-connection setting and desktop scale.
+ *
+ * AVC444 encodes each picture as two views, so the client pays a second decode
+ * per frame and, if it recovers the 4:4:4 chroma rather than discarding it, a
+ * further per-frame combine. At 1x that buys real chroma resolution. At 1.4x
+ * or 1.8x it buys much less: a 4:2:0 chroma block already covers close to a
+ * single logical pixel at that density, so most of what 4:4:4 offers has been
+ * paid for in pixels instead -- and paid for on the same decoder that is now
+ * being asked to do twice the work.
+ *
+ * Which way that trade falls also depends on the server, which is why the
+ * decision is per connection rather than per guacd. A server offering H.264
+ * from the RDPGFX 8.1 capability set, such as xrdp, simply sends AVC420 when
+ * AVC444 is not advertised. One offering it only from version 10 and later,
+ * such as Windows, sends no H.264 at all, because FreeRDP emits those sets
+ * only when GfxAVC444 is set -- so a Windows entry wants AVC444 forced on
+ * regardless of scale, while an xrdp entry beside it does not.
+ *
+ * GUAC_RDP_AVC444_AUTO defers to the desktop scale, which is non-zero only
+ * when the client asked for its framebuffer in physical pixels and reported a
+ * HiDPI device pixel ratio.
+ *
+ * The GUAC_RDP_DISABLE_AVC444 environment variable sets the default for
+ * connections that do not specify: 1 never advertises, 0 always does. It is
+ * read once and cached; two threads racing to initialise it write the same
+ * value, so no lock is needed.
+ *
+ * @param avc444
+ *     The per-connection setting: 1 to advertise, 0 not to, or
+ *     GUAC_RDP_AVC444_AUTO to decide from the desktop scale.
+ *
+ * @param desktop_scale
+ *     The desktop scale requested for this connection, as a percentage, or
+ *     zero if none was requested.
+ *
+ * @return
+ *     Non-zero if AVC444 should be advertised, zero otherwise.
+ */
+static int guac_rdp_avc444_enabled(int avc444, int desktop_scale) {
+
+    /* An explicit per-connection setting wins outright. */
+    if (avc444 != GUAC_RDP_AVC444_AUTO)
+        return avc444;
+
+    /* -1 unset, 0 forced off, 1 forced on */
+    static int override = -1;
+
+    if (override < 0) {
+
+        const char* raw = getenv("GUAC_RDP_DISABLE_AVC444");
+
+        if (raw == NULL || *raw == '\0')
+            override = GUAC_RDP_AVC444_AUTO;
+        else if (strcmp(raw, "1") == 0)
+            override = 0;
+        else
+            override = 1;
+
+    }
+
+    if (override != GUAC_RDP_AVC444_AUTO)
+        return override;
+
+    /* Automatic: the pixel density has already bought most of the chroma. */
+    return desktop_scale <= GUAC_RDP_AVC444_SCALE_THRESHOLD;
+
+}
