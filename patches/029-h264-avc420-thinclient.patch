+/**
+ * Returns non-zero if the RDPGFX AVC_THINCLIENT capability flag should be
+ * advertised, which tells the server this client supports AVC420 but not
+ * AVC444. Defaults to enabled; set GUAC_RDP_H264_AVC420_ONLY=0 to suppress it.
+ *
+ * This exists because AVC444 cannot be passed through at all: its two
+ * bitstreams are a single H.264 sequence whose pictures alternate between the
+ * main and auxiliary views, so no subset of it stands alone (see patch 028).
+ * Yet the AVC444 capability must still be advertised, because FreeRDP reaches
+ * the RDPGFX V10 capability set only via GfxAVC444, and Windows offers no
+ * H.264 at all below V10.
+ *
+ * AVC_THINCLIENT (0x40, caps 10.3+) resolves the contradiction: advertise
+ * AVC444 to reach V10, then declare AVC420-only so the server sends a stream
+ * that can actually be forwarded. FreeRDP emits the flag from GfxThinClient,
+ * and only when AVC is not disabled.
+ *
+ * @return
+ *     Non-zero if AVC_THINCLIENT should be advertised, zero otherwise.
+ */
+static int guac_rdp_h264_avc420_only(void) {
+
+    static int cached = -1;
+
+    if (cached == -1) {
+        const char* value = getenv("GUAC_RDP_H264_AVC420_ONLY");
+        cached = !(value != NULL && strcmp(value, "0") == 0);
+    }
+
+    return cached;
+
+}
+
 /**
