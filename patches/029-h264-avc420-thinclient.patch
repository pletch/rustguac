  * RDP server despite the H.264 passthrough being unable to render it, as
@@ -1706,15 +1739,30 @@ void guac_rdp_push_settings(guac_client* client,
 
             int avc444 = guac_rdp_h264_avc444_diagnostic();
 
+            int avc420_only = guac_rdp_h264_avc420_only();
+
             freerdp_settings_set_bool(rdp_settings, FreeRDP_GfxH264, TRUE);
             freerdp_settings_set_bool(rdp_settings, FreeRDP_GfxAVC444, avc444);
 
-            if (avc444)
-                guac_client_log(client, GUAC_LOG_WARNING, "GUAC_RDP_H264_AVC444 "
-                        "is set: advertising AVC444 so that the RDPGFX V10 "
-                        "capability set is offered. THE DISPLAY WILL RENDER "
-                        "INCORRECTLY. This is a diagnostic for servers that "
-                        "decline H.264 when only V8.1 is advertised.");
+            /* Declare AVC420-only at caps 10.3+. Advertising AVC444 is the
+             * only way to reach the V10 capability set, but AVC444 streams
+             * cannot be passed through, so ask the server for AVC420. */
+            freerdp_settings_set_bool(rdp_settings, FreeRDP_GfxThinClient,
+                    avc444 && avc420_only);
+
+            if (avc444 && avc420_only)
+                guac_client_log(client, GUAC_LOG_INFO,
+                        "Advertising AVC444 to reach the RDPGFX V10 capability "
+                        "set, with AVC_THINCLIENT set to request AVC420. If "
+                        "the server sends AVC444 anyway, it is ignoring that "
+                        "flag and those frames cannot be passed through.");
+
+            else if (avc444)
