+/**
+ * DIAGNOSTIC ONLY. Returns non-zero if GfxAVC444 should be advertised to the
+ * RDP server despite the H.264 passthrough being unable to render it, as
+ * controlled by the GUAC_RDP_H264_AVC444 environment variable.
+ *
+ * FreeRDP has no way to advertise the RDPGFX_CAPVERSION_10 capability set with
+ * AVC420 only: rdpgfx_send_caps_advertise_pdu() emits the V10 caps set only
+ * when GfxH264 is unset or GfxAVC444 is set, so the AVC420-only configuration
+ * used by the passthrough advertises V8/V8.1 alone. Some servers (Windows 11
+ * is the suspected case) appear to decline H.264 entirely when the client does
+ * not offer V10, falling back to progressive/clear codecs.
+ *
+ * Setting this variable restores the V10 advertisement so that it can be
+ * determined whether that is why a given server never sends AVC surface
+ * commands. THE DISPLAY WILL RENDER INCORRECTLY while it is set -- the
+ * passthrough forwards only bitstream[0] of an AVC444 stream, producing the
+ * split luma/chroma image with green and magenta casts described in
+ * patches/README.md. Use it to read the logs, not the screen.
+ *
+ * @return
+ *     Non-zero if GfxAVC444 should be advertised, zero otherwise.
+ */
+static int guac_rdp_h264_avc444_diagnostic(void) {
+
+    static int cached = -1;
+
+    if (cached == -1) {
+        const char* value = getenv("GUAC_RDP_H264_AVC444");
+        cached = (value != NULL && strcmp(value, "1") == 0);
+    }
+
+    return cached;
+
+}
