@@ -93,6 +93,17 @@ static UINT guac_rdp_gfx_surface_command(RdpgfxClientContext* context,
     guac_client* client = ((rdp_freerdp_context*) rdp_context)->client;
     guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
 
+    /* Log the codec of every surface command, not just H.264 ones. Without
+     * this there is no way to tell a server that is sending no H.264 from one
+     * that is mixing H.264 with progressive/clear/planar commands -- both look
+     * identical from the H.264-only trace output. Codec IDs are those of
+     * MS-RDPEGFX: 3=UNCOMPRESSED, 8=CAVIDEO(RFX), 9=CLEARCODEC, 10=PLANAR,
+     * 11=AVC420, 12=ALPHA, 13=AVC444, 15=AVC444v2, 16=PROGRESSIVE,
+     * 17=PROGRESSIVE_V2. */
+    guac_client_log(client, GUAC_LOG_TRACE,
+            "GFX surface command: codec=%u, %ux%u at %u,%u",
+            cmd->codecId, cmd->width, cmd->height, cmd->left, cmd->top);
+
     /* Save H.264 NAL data BEFORE calling the original handler. The original
      * GDI handler may free or modify cmd->extra data during AVC decoding,
      * so we must copy it while it's still valid. */
