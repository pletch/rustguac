+/**
+ * Copies the region rects of an H.264 metablock into a newly allocated array of
+ * guac_rect, converting from FreeRDP's RECTANGLE_16 (left/top/right/bottom) to
+ * the left/top/width/height form taken by guac_rect_init().
+ *
+ * These regions identify which parts of the decoded picture are actually
+ * valid. The picture is always full-surface sized, so a server that encodes
+ * only part of the screen as H.264 -- as Windows does when mixing codecs --
+ * leaves the remainder holding no meaningful content. Forwarding the regions
+ * lets the client draw only those parts instead of blitting the whole picture
+ * over regions delivered by other codecs.
+ *
+ * @param meta
+ *     The metablock whose region rects should be copied.
+ *
+ * @param num_rects
+ *     Pointer to an int that will receive the number of rects copied.
+ *
+ * @return
+ *     A newly allocated array of guac_rect which must be freed by the caller,
+ *     or NULL if the metablock contains no regions.
+ */
+static guac_rect* guac_rdp_h264_copy_rects(const RDPGFX_H264_METABLOCK* meta,
+        int* num_rects) {
+
+    *num_rects = 0;
+
+    if (meta == NULL || meta->numRegionRects == 0 || meta->regionRects == NULL)
+        return NULL;
+
+    guac_rect* rects = malloc(meta->numRegionRects * sizeof(guac_rect));
+    if (rects == NULL)
+        return NULL;
+
+    for (UINT32 i = 0; i < meta->numRegionRects; i++) {
+        const RECTANGLE_16* src = &meta->regionRects[i];
+        guac_rect_init(&rects[i], src->left, src->top,
+                src->right - src->left, src->bottom - src->top);
+    }
+
+    *num_rects = (int) meta->numRegionRects;
+    return rects;
+
+}
