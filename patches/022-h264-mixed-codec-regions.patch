+ * currently being flushed. Such regions must be sent as images regardless of
+ * whether the H.264 stream also covers them, since the H.264 picture does not
+ * carry what the other codec painted.
+ */
+static int guac_display_layer_mixed_covers(guac_display_layer* layer,
+        const guac_rect* rect) {
