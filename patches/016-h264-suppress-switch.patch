+/**
+ * Returns non-zero if image operations overlapping H.264 regions should be
+ * suppressed. Suppression is an optimization -- it avoids re-encoding regions
+ * the H.264 stream already carries -- and setting GUAC_H264_SUPPRESS=0 turns
+ * it off so that a suspected over-suppression can be confirmed. With it off
+ * the display is still correct (image operations are drawn after the H.264
+ * frames of the same guacd frame, so they win), merely more expensive.
+ */
+static int guac_h264_suppress_enabled(void) {
+
+    static int cached = -1;
+
+    if (cached == -1) {
+        const char* value = getenv("GUAC_H264_SUPPRESS");
+        cached = !(value != NULL && strcmp(value, "0") == 0);
+    }
+
+    return cached;
+
+}
